{
  "name": "miku-visual3d",
  "displayName": "Miku Visual 3D",
  "icon": "media/brand.png",
  "description": "NIfTI medical image viewer with linked 2D slices, segmentation overlays and 3D surfaces. Supports local and Remote-SSH workspaces.",
  "version": "1.0.0",
  "type": "module",
  "publisher": "miku-local",
  "license": "BSD-2-Clause",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "NIfTI",
    "medical imaging",
    "CT",
    "MRI",
    "segmentation",
    "3D",
    "Remote-SSH"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCustomEditor:mikuVisual.image",
    "onCommand:mikuVisual.open"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension reads image files using the workspace host filesystem."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mikuVisual.open",
        "title": "MikuVisual: Open Image"
      },
      {
        "command": "mikuVisual.logs",
        "title": "MikuVisual: Show Logs"
      },
      {
        "command": "mikuVisual.addOverlay",
        "title": "MikuVisual: Add Image",
        "enablement": "mikuVisual.hasOpenImage"
      }
    ],
    "customEditors": [
      {
        "viewType": "mikuVisual.image",
        "displayName": "MikuVisual3D",
        "selector": [
          {
            "filenamePattern": "*.nii"
          },
          {
            "filenamePattern": "*.nii.gz"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mikuVisual.addOverlay",
          "when": "mikuVisual.hasOpenImage && resourceFilename =~ /\\.nii(\\.gz)?$/i",
          "group": "zzzz_mikuVisual@1000"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "package": "npm run check && npm run test && npm run build && vsce package --no-dependencies --githubBranch main --out builds/miku-visual3d-1.0.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "author": {
    "name": "eejyang",
    "url": "https://github.com/eejyang"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eejyang/miku-visual3d.git"
  },
  "homepage": "https://github.com/eejyang/miku-visual3d#readme",
  "bugs": {
    "url": "https://github.com/eejyang/miku-visual3d/issues"
  }
}
