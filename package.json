{
  "name": "miku-volume",
  "displayName": "Miku Volume",
  "icon": "media/brand.png",
  "description": "NIfTI medical image viewer with linked 2D slices, segmentation overlays and 3D surfaces.",
  "version": "1.0.0",
  "type": "module",
  "publisher": "eejyang",
  "license": "BSD-2-Clause",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "NIfTI",
    "medical imaging",
    "CT",
    "MRI",
    "segmentation",
    "3D"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCustomEditor:mikuVolume.image",
    "onCommand:mikuVolume.open"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension reads image files using the workspace host filesystem."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mikuVolume.open",
        "title": "Miku Volume: Open Image"
      },
      {
        "command": "mikuVolume.logs",
        "title": "Miku Volume: Show Logs"
      },
      {
        "command": "mikuVolume.addOverlay",
        "title": "Miku Volume: Add Image",
        "enablement": "mikuVolume.hasOpenImage"
      }
    ],
    "customEditors": [
      {
        "viewType": "mikuVolume.image",
        "displayName": "Miku Volume",
        "selector": [
          {
            "filenamePattern": "*.nii"
          },
          {
            "filenamePattern": "*.nii.gz"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mikuVolume.addOverlay",
          "when": "mikuVolume.hasOpenImage && resourceFilename =~ /\\.nii(\\.gz)?$/i",
          "group": "zzzz_mikuVolume@1000"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "package": "npm run check && npm run test && npm run build && vsce package --no-dependencies --githubBranch main --out builds/miku-volume-1.0.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "author": {
    "name": "eejyang",
    "url": "https://github.com/eejyang"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eejyang/miku-volume.git"
  },
  "homepage": "https://github.com/eejyang/miku-volume#readme",
  "bugs": {
    "url": "https://github.com/eejyang/miku-volume/issues"
  }
}
