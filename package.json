{
  "name": "miku-visual",
  "displayName": "miku visual",
  "icon": "media/brand.png",
  "description": "Remote-first NIfTI viewer with 2D slices and Flying Edges mask surfaces. Read volumes on the workspace host; transfer only slices and meshes.",
  "version": "0.0.0",
  "type": "module",
  "publisher": "miku-local",
  "license": "BSD-2-Clause",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCustomEditor:mikuVisual.image",
    "onCommand:mikuVisual.open"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension reads image files using the workspace host filesystem."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mikuVisual.open",
        "title": "miku visual: Open Image"
      },
      {
        "command": "mikuVisual.logs",
        "title": "miku visual: Show Logs"
      },
      {
        "command": "mikuVisual.addOverlay",
        "title": "MikuVisual: Add Image",
        "enablement": "mikuVisual.hasOpenImage"
      }
    ],
    "customEditors": [
      {
        "viewType": "mikuVisual.image",
        "displayName": "miku visual",
        "selector": [
          {
            "filenamePattern": "*.nii"
          },
          {
            "filenamePattern": "*.nii.gz"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mikuVisual.addOverlay",
          "when": "mikuVisual.hasOpenImage && resourceFilename =~ /\\.nii(\\.gz)?$/i",
          "group": "zzzz_mikuVisual@1000"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "package": "npm run check && npm run test && npm run build && vsce package --no-dependencies --allow-missing-repository --out builds/miku-visual-0.0.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
